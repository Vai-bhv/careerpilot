# SQLite is the native fallback when DATABASE_URL is empty.
DATABASE_URL=
CAREERPILOT_PRIVATE=private
# Optionally set a random token here. careerpilot init creates private/api.token.
CAREERPILOT_TOKEN=
# Compose requires a locally generated alphanumeric password.
POSTGRES_PASSWORD=
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
YAHOO_FOLDER=Jobs
YAHOO_FROM=
YAHOO_SEARCH=UNSEEN
CAREERPILOT_TIMEZONE=Europe/Prague
CAREERPILOT_LLM=mock
OLLAMA_MODEL=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
CAREERPILOT_DAILY_USD=0
CAREERPILOT_MAIL=yahoo
CAREERPILOT_RETENTION_DAYS=90
